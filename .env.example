# ─────────────────────────────────────────────
# Neon PostgreSQL — your primary database
# Get this from: https://console.neon.tech → your project → Connection string
# ─────────────────────────────────────────────
NEON_DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────
# JWT — used to sign and verify auth tokens
# Generate a secure value: openssl rand -hex 32
# ─────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this

# ─────────────────────────────────────────────
# App environment
# ─────────────────────────────────────────────
NODE_ENV=development
